# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth0 tenant ──────────────────────────────────────────────────────────────
# Found in: Auth0 Dashboard → Settings → General → Domain
# Format:   {tenant}.{region}.auth0.com   (no https://, no trailing slash)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# The API Identifier you set when registering your API in Auth0
# Auth0 Dashboard → Applications → APIs → {Your API} → Settings → Identifier
AUTH0_AUDIENCE=https://anon-skill.evoa.one/api

# ── Regular Web Application (OAuth redirect + Token Vault exchange) ───────────
# Auth0 Dashboard → Applications → Applications → {Your App} → Settings
#
# Token Vault setup required on this app:
#   Advanced Settings → Grant Types → enable:
#   "urn:auth0:params:oauth:grant-type:token-exchange:federated-connection-access-token"
AUTH0_CLIENT_ID=your_web_app_client_id
AUTH0_CLIENT_SECRET=your_web_app_client_secret

# ── Routing ───────────────────────────────────────────────────────────────────
# Must appear in: Auth0 Dashboard → Applications → {Your App} → Allowed Callback URLs
CALLBACK_URL=http://localhost:8000/oauth/callback

# Origin of your Next.js frontend (used for CORS and post-login redirects)
FRONTEND_URL=http://localhost:3000

# ── GitHub social connection ──────────────────────────────────────────────────
# Auth0 Dashboard → Authentication → Social → GitHub → "Name" field
# Default is "github" unless you renamed the connection.
# Token Vault must also be enabled on this connection:
#   Authentication → Social → GitHub → Token Vault toggle → Enable
GITHUB_CONNECTION_NAME=github

# ── Gemini API ────────────────────────────────────────────────────────────────
# Google AI Studio → Get API Key → https://aistudio.google.com/app/apikey
# Used by the AI agent to generate the VerificationReport (POST /agent/verify)
GEMINI_API_KEY=your_gemini_api_key
